        }
        
        .gold-glow-lg {
            box-shadow: 0 0 50px rgba(234, 179, 8, 0.55);
        }

        .text-gold-gradient {
            background: linear-gradient(135deg, #FFF599 0%, #FACC15 50%, #CA8A04 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn-gold {
            background: linear-gradient(135deg, #FACC15 0%, #EAB308 50%, #CA8A04 100%);
            color: #000;
            font-weight: 800;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, #FFE066 0%, #FACC15 50%, #EAB308 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(234, 179, 8, 0.45);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #090a0f;
        }
        ::-webkit-scrollbar-thumb {
            background: #25283b;
